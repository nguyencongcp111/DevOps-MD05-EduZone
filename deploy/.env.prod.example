# Sao chép thành deploy/.env.prod, đổi mật khẩu. KHÔNG commit file .env.prod.
# scripts/deploy.sh sẽ chép file này lên máy chủ thành ~/eduzone/.env và tự điền IMAGE_TAG.

# Chủ sở hữu image trên ghcr.io (chữ thường)
GHCR_OWNER=nguyencongcp111
# Bảy ký tự đầu của commit — deploy.sh tự ghi đè
IMAGE_TAG=

POSTGRES_PASSWORD=CHANGE_ME_admin
COURSE_DB_PASSWORD=CHANGE_ME_course
STUDENT_DB_PASSWORD=CHANGE_ME_student
ENROLLMENT_DB_PASSWORD=CHANGE_ME_enrollment
ACCESS_DB_PASSWORD=CHANGE_ME_access

# Ngày 2: 0.0.0.0 (curl bằng IP công khai). Ngày 3: 127.0.0.1 (chỉ Nginx truy cập).
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
